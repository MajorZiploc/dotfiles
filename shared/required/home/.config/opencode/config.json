{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "dotnet build *": "ask",
      "dotnet test *": "ask",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
