      "telnet *": "ask",
      "nc *": "ask",
      "netcat *": "ask",
      "gam *": "ask"
    },
    "websearch": "ask",
    "webfetch": "ask",
    "read": {
      "*": "allow",
      "**/*.bak*": "ask",
      "**/*.old*": "ask",
      "**/*.OLD*": "ask",
